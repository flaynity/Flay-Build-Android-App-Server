{
  "name": "flay-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "vars": {
    "GITHUB_REPO": "flaynity/Flay-Build-Android-App-Server",
    "GITHUB_WORKFLOW": "android-build.yml",
    "BUILD_SERVER_URL": "https://flay-ai.flaynity.workers.dev"
  },
  "r2_buckets": [
    { "binding": "BUILD_BUCKET", "bucket_name": "flay-ai-builds" }
  ],
  "secrets": { "required": ["GITHUB_TOKEN", "INTERNAL_TOKEN"] },
  "exports": {
    "FlayBuildContainer": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}
